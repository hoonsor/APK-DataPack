{
  "name": "datapack-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run --quiet -- next dev",
    "build": "next build",
    "start": "dotenvx run --quiet -- next start",
    "lint": "eslint",
    "build:local": "dotenvx run --quiet -- next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "env:push": "dotenvx run --quiet -- node scripts/vercel-env-push.mjs",
    "env:push:dry": "dotenvx run --quiet -- node scripts/vercel-env-push.mjs --dry-run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
